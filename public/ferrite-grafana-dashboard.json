    {
      "id": 21,
      "type": "state-timeline",
      "title": "Egress health",
      "description": "Passive health (breaker + WireGuard handshake) and the last active probe, per egress.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 68,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": { "tooltip": false, "viz": false, "legend": false }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red", "index": 1 },
                "1": { "text": "Up", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
